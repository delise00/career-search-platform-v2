# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ==========================================
# Google Jobs (SerpApi) Configuration
# ==========================================
# Google Jobs SerpApi Endpoint URL
GOOGLE_JOBS_URL="https://serpapi.com/search?engine=google_jobs"

# SerpApi Key: Optional for live SerpApi Google Jobs queries
# (Obtain free API key from https://serpapi.com and configure in Secrets or Vercel Env Vars)
SERPAPI_API_KEY=""

# Enable built-in simulation / benchmark dataset when live SerpApi key is not set or limit reached
MCP_ENABLE_LOCAL_SIMULATION="true"
