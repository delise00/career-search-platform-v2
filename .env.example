# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ==========================================
# JobDataLake MCP Configuration
# ==========================================
# Endpoint for official JobDataLake MCP Server:
JOBDATALAKE_MCP_URL="https://mcp.jobdatalake.com"

# Optional API key for unlimited queries (500 free calls/day without key)
JOBDATALAKE_API_KEY=""

# Built-in local benchmark dataset when offline
MCP_ENABLE_LOCAL_SIMULATION="true"
