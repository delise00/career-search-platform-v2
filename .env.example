# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ==========================================
# Google Jobs Configuration
# ==========================================
# Google Jobs Smithery MCP Endpoint URL:
GOOGLE_JOBS_URL="https://server.smithery.ai/google/jobs"

# Smithery API Key: Optional for live Smithery MCP remote queries
# (Obtain key from https://smithery.ai and configure in environment)
SMITHERY_API_KEY=""

# Alternatively, direct SerpApi key if using SerpApi endpoint:
SERPAPI_API_KEY=""

# Enable built-in benchmark dataset when remote key is not set or limit reached
MCP_ENABLE_LOCAL_SIMULATION="true"
